# Copy to .env and fill in (never commit .env)
#   cp .env.example .env

# --- Postgres (docker compose) ---
POSTGRES_USER=sendell
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=sendell

# Host port for the app
SENDELL_PORT=8080

# Public URL as seen by phone + Grok machine (no trailing slash)
# Examples:
#   http://203.0.113.10:8080
#   https://remote.sendell.example
SENDELL_PUBLIC_URL=http://YOUR_VPS_IP:8080

# Optional auth secret (32+ random chars) if you enable sign-in later
BETTER_AUTH_SECRET=generate-a-long-random-string

# Local dev without Docker (optional): leave unset to use embedded PGLite
# DATABASE_URL=postgres://sendell:sendell@127.0.0.1:5432/sendell
